{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyFrontmatterSchema",
  "description": "Validation schema for authoring Markdown policy frontmatter in corpora/policy/*.md",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^POL-[A-Z0-9_-]+$",
      "description": "Unique authoritative policy identifier (e.g. POL-CARD-DECLINE-01)"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*$",
      "description": "Semantic policy revision tag (e.g. v1.0, v2)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Clear human-readable policy title"
    },
    "intent_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Canonical taxonomy intent labels covered by this policy"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Operational risk level associated with executing this procedure"
    },
    "owner": {
      "type": "string",
      "minLength": 3,
      "description": "Compliance or departmental owner"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Effective start date (YYYY-MM-DD)"
    },
    "effective_to": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Expiration date if applicable"
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "retired"],
      "description": "Operational lifecycle state of the policy"
    }
  },
  "required": [
    "policy_id",
    "version",
    "title",
    "intent_labels",
    "risk_level",
    "owner",
    "effective_from",
    "status"
  ],
  "additionalProperties": false
}
